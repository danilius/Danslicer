<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Danslicer.App.ViewModels"
        xmlns:controls="using:Danslicer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Danslicer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1400" Height="900"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="FieldTemplate" x:DataType="vm:NumericField">
            <Grid ColumnDefinitions="18,*,28" Margin="0,2">
                <TextBlock Text="{Binding Label}" Classes="label" />
                <controls:ExpressionBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="{Binding Suffix}" Classes="label" Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WideFieldTemplate" x:DataType="vm:NumericField">
            <Grid ColumnDefinitions="120,*,48" Margin="0,2">
                <TextBlock Text="{Binding Label}" Classes="label" />
                <controls:ExpressionBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="{Binding Suffix}" Classes="label" Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#C8CCD0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style Selector="controls|ExpressionBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="ToggleButton.tool">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="TextBlock.headerSep">
            <Setter Property="Text" Value="│" />
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="Margin" Value="6,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="OpenProjectMenuItem" Header="_Open Project..." Click="OnOpenProjectClick" />
                <MenuItem x:Name="SaveProjectMenuItem" Header="_Save Project" Click="OnSaveProjectClick" />
                <MenuItem x:Name="SaveProjectAsMenuItem" Header="Save Project _As..." Click="OnSaveProjectAsClick" />
                <Separator />
                <MenuItem x:Name="ImportMenuItem" Header="_Import STL..." Click="OnImportClick" />
                <MenuItem x:Name="FileExportMenuItem" Header="_Export Print File..." Click="OnExportClick"
                          IsVisible="{Binding IsLayersView}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo" Command="{Binding UndoCommand}" />
                <MenuItem x:Name="RedoMenuItem" Header="_Redo" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem x:Name="SelectAllMenuItem" Header="Select _All" Command="{Binding SelectAllCommand}" />
                <MenuItem x:Name="DeleteMenuItem" Header="_Delete" Command="{Binding DeleteCommand}" />
                <Separator />
                <MenuItem x:Name="PreferencesMenuItem" Header="_Preferences..." Click="OnPreferencesClick" />
            </MenuItem>
            <MenuItem Header="_Object" IsVisible="{Binding IsModelView}">
                <MenuItem x:Name="DropToPlateMenuItem" Header="_Drop to Plate" Command="{Binding DropToPlateScopedCommand}"
                          IsVisible="{Binding DropToPlateScopedCommand.IsAvailable}" />
                <MenuItem Header="Lay _Flat on Face" Click="OnLayFlatClick" InputGesture="F"
                          IsVisible="{Binding IsLayoutView}" />
                <Separator IsVisible="{Binding IsModelView}" />
                <MenuItem Header="_Hide" Command="{Binding HideScopedCommand}" InputGesture="H"
                          IsVisible="{Binding HideScopedCommand.IsAvailable}" />
                <MenuItem x:Name="HideUnselectedMenuItem" Header="Hide _Unselected Supports" Command="{Binding HideUnselectedSupportsScopedCommand}"
                          IsVisible="{Binding HideUnselectedSupportsScopedCommand.IsAvailable}" />
                <MenuItem Header="_Unhide All" Command="{Binding UnhideAllScopedCommand}" InputGesture="Alt+H"
                          IsVisible="{Binding UnhideAllScopedCommand.IsAvailable}" />
                <Separator IsVisible="{Binding IsSupportView}" />
                <MenuItem x:Name="GenerateSupportsMenuItem" Header="_Generate Supports" Command="{Binding GenerateSupportsScopedCommand}"
                          IsVisible="{Binding GenerateSupportsScopedCommand.IsAvailable}" />
                <Separator IsVisible="{Binding IsModelView}" />
                <!-- MenuItem.IsChecked binds one-way by default, unlike ToggleButton: Mode=TwoWay is required. -->
                <MenuItem Header="Move _Gizmo" ToggleType="CheckBox" IsChecked="{Binding ShowMoveGizmo, Mode=TwoWay}"
                          IsVisible="{Binding IsLayoutView}" />
                <MenuItem Header="_Rotate Gizmo" ToggleType="CheckBox" IsChecked="{Binding ShowRotateGizmo, Mode=TwoWay}"
                          IsVisible="{Binding IsLayoutView}" />
                <MenuItem Header="_Scale Gizmo" ToggleType="CheckBox" IsChecked="{Binding ShowScaleGizmo, Mode=TwoWay}"
                          IsVisible="{Binding IsLayoutView}" />
                <MenuItem Header="S_napping" ToggleType="CheckBox" IsChecked="{Binding SnapEnabled, Mode=TwoWay}"
                          InputGesture="Shift+Tab" IsVisible="{Binding IsLayoutView}" />
                <Separator IsVisible="{Binding IsModelView}" />
                <MenuItem Header="Over_hang Tint" ToggleType="CheckBox" IsChecked="{Binding ShowOverhangs, Mode=TwoWay}"
                          IsVisible="{Binding IsModelView}" />
            </MenuItem>
            <MenuItem Header="_Print" IsVisible="{Binding IsLayersView}">
                <MenuItem x:Name="SliceMenuItem" Header="_Slice" Command="{Binding SliceScopedCommand}" />
                <MenuItem x:Name="PrintExportMenuItem" Header="_Export Print File..." Click="OnExportClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle Workspace / _Slicing" Command="{Binding ToggleViewCommand}" InputGesture="Tab" />
                <Separator />
                <MenuItem Header="Frame _All" Click="OnFrameAllClick" InputGesture="Home" />
                <MenuItem Header="Frame _Selected" Click="OnFrameSelectedClick" InputGesture="OemPeriod" />
                <Separator />
                <MenuItem Header="_Front" Click="OnViewFrontClick" InputGesture="D1" />
                <MenuItem Header="_Right" Click="OnViewRightClick" InputGesture="D3" />
                <MenuItem Header="_Top" Click="OnViewTopClick" InputGesture="D7" />
                <Separator />
                <MenuItem Header="Toggle _Perspective/Orthographic" Click="OnToggleProjectionClick" InputGesture="D5" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="#1B1D20" Padding="8,3">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding ViewportStatus}" Classes="label" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="160" Height="8" Margin="12,0" Minimum="0" Maximum="1"
                             Value="{Binding SliceProgress}" IsVisible="{Binding IsSlicing}" />
                <TextBlock Grid.Column="2" Text="{Binding HistoryStatus}" Classes="label" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#23262A" Padding="10,5"
                IsVisible="{Binding IsGeneratingSupports}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Text="Generating supports" Classes="label" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1"
                             Value="{Binding GenerationProgress}" Height="10" />
                <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelSupportGenerationCommand}"
                        Padding="12,2" />
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="320" MinWidth="220" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#23262A" BorderBrush="#111" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Objects" Classes="section" Margin="10,8,10,4" />
                <ListBox ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}"
                         Background="Transparent" Margin="4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#151719" />

        <Border Grid.Column="4" Background="#23262A" BorderBrush="#111" BorderThickness="1,0,0,0" Padding="10,4">
            <Grid>
                <ScrollViewer IsVisible="{Binding IsLayoutView}">
                    <StackPanel IsEnabled="{Binding SelectedObject, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="Object" Classes="section" />
                        <TextBlock Text="{Binding SelectedObject.Name, FallbackValue=''}" FontSize="13" />
                        <TextBlock Text="{Binding TriangleText}" Classes="label" />
                        <TextBlock Text="{Binding DimensionsText}" Classes="label" />

                        <TextBlock Text="Position" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Position}" ItemTemplate="{StaticResource FieldTemplate}" />

                        <TextBlock Text="Rotation" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Rotation}" ItemTemplate="{StaticResource FieldTemplate}" />

                        <TextBlock Text="Scale" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Scale}" ItemTemplate="{StaticResource FieldTemplate}" />

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsSupportView}">
                    <StackPanel>
                        <TextBlock Text="Support" Classes="section" />
                        <TextBlock Text="Layer range" Classes="label"
                                   ToolTip.Tip="Viewport isolation only — slicing and support generation are unaffected" />
                        <controls:LayerRangeSlider Minimum="{Binding SupportClip.MinimumZ}"
                                                   Maximum="{Binding SupportClip.MaximumZ}"
                                                   LowerValue="{Binding SupportClip.LowerZ, Mode=TwoWay}"
                                                   UpperValue="{Binding SupportClip.UpperZ, Mode=TwoWay}"
                                                   ToolTip.Tip="Drag either end to clip the Support viewport from below or above" />
                        <Grid ColumnDefinitions="Auto,58,Auto,Auto,58,Auto,*" Margin="0,0,0,6">
                            <TextBlock Text="Low" Classes="label" Margin="0,0,4,0" />
                            <controls:ExpressionBox Grid.Column="1" Text="{Binding SupportClip.LowerField.Text, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="mm" Classes="label" Margin="4,0,10,0" />
                            <TextBlock Grid.Column="3" Text="High" Classes="label" Margin="0,0,4,0" />
                            <controls:ExpressionBox Grid.Column="4" Text="{Binding SupportClip.UpperField.Text, Mode=TwoWay}" />
                            <TextBlock Grid.Column="5" Text="mm" Classes="label" Margin="4,0,0,0" />
                            <Button Grid.Column="6" Content="Reset" Command="{Binding SupportClip.ResetCommand}"
                                    HorizontalAlignment="Right" Padding="8,2" />
                        </Grid>
                        <Grid ColumnDefinitions="90,*" Margin="0,0,0,4">
                            <TextBlock Text="Display" Classes="label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SupportSettings.SupportDisplayModes}"
                                      SelectedIndex="{Binding SupportSettings.SupportDisplayModeIndex, Mode=TwoWay}" />
                        </Grid>
                        <WrapPanel Margin="0,2,0,4"
                                   IsEnabled="{Binding SupportSettings.IsSupportElementVisibilityAvailable}">
                            <CheckBox Content="Tips" IsChecked="{Binding SupportSettings.ShowSupportTips}" Margin="0,0,8,0" />
                            <CheckBox Content="Minis" IsChecked="{Binding SupportSettings.ShowMiniSupports}" Margin="0,0,8,0" />
                            <CheckBox Content="Branches" IsChecked="{Binding SupportSettings.ShowSupportBranches}" Margin="0,0,8,0" />
                            <CheckBox Content="Trunks" IsChecked="{Binding SupportSettings.ShowSupportTrunks}" Margin="0,0,8,0" />
                            <CheckBox Content="Bases" IsChecked="{Binding SupportSettings.ShowSupportBases}" Margin="0,0,8,0" />
                            <CheckBox Content="Bracing" IsChecked="{Binding SupportSettings.ShowSupportBracing}" />
                        </WrapPanel>
                        <CheckBox Content="Contact points over transparent supports"
                                  IsChecked="{Binding SupportSettings.ShowContactPointsInTransparent}"
                                  IsVisible="{Binding SupportSettings.IsTransparentSupportDisplay}"
                                  Margin="0,0,0,4" />
                        <ToggleButton Content="Select Through" IsChecked="{Binding SelectThroughSupports}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Marquee-select supports hidden behind the model; hidden support elements remain excluded" />
                        <Button Content="Generate Supports" Command="{Binding GenerateSupportsScopedCommand}"
                                HorizontalAlignment="Stretch" Margin="0,6,0,2" />
                        <TextBlock Text="Settings" Classes="section" />
                        <controls:SupportSettingsView DataContext="{Binding SupportSettings}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsLayersView}">
                    <StackPanel>
                        <TextBlock Text="Printer" Classes="section" />
                        <ComboBox ItemsSource="{Binding PrinterDisplayNames}"
                                  SelectedIndex="{Binding SelectedPrinterIndex, Mode=TwoWay}"
                                  Margin="0,0,0,4" />

                        <TextBlock Text="Resin" Classes="section" />
                        <ComboBox ItemsSource="{Binding SupportSettings.Resins.DisplayNames}"
                                  SelectedIndex="{Binding SupportSettings.Resins.SelectedIndex, Mode=TwoWay}"
                                  Margin="0,0,0,4" />
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Save" Command="{Binding SupportSettings.Resins.SaveCommand}" Margin="0,0,4,4" />
                            <Button Content="Save As…" Command="{Binding SupportSettings.Resins.BeginSaveAsCommand}" Margin="0,0,4,4" />
                            <Button Content="Rename" Command="{Binding SupportSettings.Resins.BeginRenameCommand}" Margin="0,0,4,4" />
                            <Button Content="Delete" Command="{Binding SupportSettings.Resins.DeleteCommand}" Margin="0,0,0,4" />
                        </WrapPanel>
                        <StackPanel IsVisible="{Binding SupportSettings.Resins.IsNameEditorVisible}" Margin="0,0,0,4">
                            <TextBox Text="{Binding SupportSettings.Resins.NameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Preset name" />
                            <TextBlock Text="{Binding SupportSettings.Resins.ValidationMessage}"
                                       IsVisible="{Binding SupportSettings.Resins.HasValidationMessage}"
                                       Foreground="#FFB35C" FontSize="11" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="{Binding SupportSettings.Resins.NameEditorAction}"
                                        Command="{Binding SupportSettings.Resins.ConfirmNameCommand}" Margin="0,0,4,0" />
                                <Button Content="Cancel" Command="{Binding SupportSettings.Resins.CancelNameCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SupportSettings.Resins.Fields}"
                                      ItemTemplate="{StaticResource WideFieldTemplate}" />

                        <TextBlock Text="Print" Classes="section" />
                        <ItemsControl ItemsSource="{Binding PrintSettings.Fields}" ItemTemplate="{StaticResource WideFieldTemplate}" />
                        <CheckBox Content="Anti-aliasing (16 levels)" IsChecked="{Binding PrintSettings.AntiAliasing}" Margin="0,6,0,0" FontSize="12" />

                        <TextBlock Text="Slice" Classes="section" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Slice" Command="{Binding SliceScopedCommand}" MinWidth="80" />
                            <Button Content="Export…" Click="OnExportClick" MinWidth="80" />
                        </StackPanel>
                        <TextBlock Text="{Binding SliceSummary}" Classes="label" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#151719" />

        <!-- Main area: header strip, then either the 3D model view or the layer view. -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Background="#1F2124" BorderBrush="#111" BorderThickness="0,0,0,1" Padding="8,3">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsLayoutView}">
                        <TextBlock Text="Gizmo" Classes="label" Margin="0,0,8,0" />
                        <ToggleButton Classes="tool" Content="Move" IsChecked="{Binding ShowMoveGizmo}" ToolTip.Tip="Show move gizmo" />
                        <ToggleButton Classes="tool" Content="Rotate" IsChecked="{Binding ShowRotateGizmo}" ToolTip.Tip="Show rotate gizmo" />
                        <ToggleButton Classes="tool" Content="Scale" IsChecked="{Binding ShowScaleGizmo}" ToolTip.Tip="Show scale gizmo" />
                        <TextBlock Classes="headerSep" />
                        <ToggleButton Classes="tool" Content="Snap" IsChecked="{Binding SnapEnabled}" ToolTip.Tip="Snapping (Shift+Tab). Ctrl inverts while dragging. 1 mm, 5°, 0.1×" />
                        <TextBlock Classes="headerSep" />
                        <ToggleButton Classes="tool" Content="Auto Drop" IsChecked="{Binding AutoDropEnabled}" ToolTip.Tip="Re-seat the lowest mesh point at the entered offset after every transform" />
                        <controls:ExpressionBox Width="58" Text="{Binding PlacementHeight.Text, Mode=TwoWay}"
                                                ToolTip.Tip="Lowest-point offset above the plate (0 = on plate)" />
                        <TextBlock Text="mm" Classes="label" Margin="4,0,4,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Workspace" Classes="label" Margin="0,0,8,0" />
                        <ToggleButton Classes="tool" Content="Layout" IsChecked="{Binding IsLayoutView}" />
                        <ToggleButton Classes="tool" Content="Support" IsChecked="{Binding IsSupportView}" />
                        <ToggleButton Classes="tool" Content="Slicing" IsChecked="{Binding IsLayersView}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <controls:ViewportControl x:Name="Viewport" Document="{Binding Document}"
                                          IsVisible="{Binding IsModelView}"
                                          SupportSelectionMode="{Binding IsSupportView}"
                                          SelectThroughSupports="{Binding SelectThroughSupports}"
                                          SupportDisplay="{Binding SupportSettings.SupportDisplay}"
                                          ClipRange="{Binding ViewportClipRange}"
                                          ShowMoveGizmo="{Binding ShowMoveGizmo}"
                                          ShowRotateGizmo="{Binding ShowRotateGizmo}"
                                          ShowScaleGizmo="{Binding ShowScaleGizmo}"
                                          SnapEnabled="{Binding SnapEnabled, Mode=TwoWay}"
                                          ShowOverhangs="{Binding ShowOverhangs}" />

                <!-- Marquee lives above the viewport: the GL composition surface covers the
                     viewport's own 2D layer, so a rectangle drawn there is invisible. -->
                <controls:SelectionRectOverlay IsVisible="{Binding IsModelView}"
                                               Rect="{Binding #Viewport.MarqueeRect}" />

                <DockPanel IsVisible="{Binding IsLayersView}">
                    <Border DockPanel.Dock="Bottom" Background="#1F2124" BorderBrush="#111" BorderThickness="0,1,0,0" Padding="10,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider Minimum="0" Maximum="{Binding PreviewLayerMax}" Value="{Binding PreviewLayer}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PreviewLayerText}" Classes="label" Margin="16,0,0,0" MinWidth="360" />
                        </Grid>
                    </Border>
                    <controls:LayerPreviewControl x:Name="LayerView" Bitmap="{Binding PreviewImage}" />
                </DockPanel>
            </Grid>
        </DockPanel>
        </Grid>
    </DockPanel>
</Window>
