<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Danslicer.App.ViewModels"
        xmlns:controls="using:Danslicer.App.Controls"
        xmlns:refresh="using:Danslicer.App.Controls.Refresh"
        xmlns:printers="using:Danslicer.Core.Printers"
        x:Class="Danslicer.App.Views.ConfigWindow"
        x:DataType="vm:ConfigViewModel"
        Width="760" Height="540" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppPanel}"
        Title="Preferences">

    <Window.Resources>
        <DataTemplate x:Key="PrinterFieldTemplate" x:DataType="vm:NumericField">
            <Grid ColumnDefinitions="130,*,52" Margin="0,2">
                <TextBlock Text="{Binding Label}" Classes="label" />
                <controls:ExpressionBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Column="2" Text="{Binding Suffix}" Classes="label" Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextFaint}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource AppTextFaint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MaxWidth" Value="620" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="controls|ExpressionBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="190" Background="{DynamicResource AppHeader}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" PlaceholderText="Search"
                         Margin="8,8,8,4" FontSize="12" TextChanged="OnSearchChanged" />
                <ListBox x:Name="SectionList" Background="Transparent" Margin="4,0"
                         SelectionChanged="OnSectionSelected">
                    <ListBoxItem Content="Appearance" />
                    <ListBoxItem Content="Viewport" />
                    <ListBoxItem Content="Keymap" />
                    <ListBoxItem Content="Printers" />
                    <ListBoxItem Content="Resins" />
                    <ListBoxItem Content="Supports" />
                    <ListBoxItem Content="External tools" />
                    <ListBoxItem Content="SpaceMouse" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- One long scrollable pane holding every section; the list scrolls to a section,
             the search box hides rows that do not match. -->
        <ScrollViewer x:Name="Scroll" Padding="16,4,16,16">
            <StackPanel x:Name="Sections">

                <StackPanel x:Name="AppearanceSection">
                    <TextBlock Text="Appearance" Classes="section" Margin="0,0,0,6" />
                    <Grid Tag="appearance theme colour color scheme dark blender carbide classic slate techy palette"
                          ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Theme" Classes="label" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="160"
                                  ItemsSource="{Binding ThemeNames}"
                                  SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="The colour scheme of every window. Applies at once; the viewport keeps its own model colours." />
                    <TextBlock Tag="appearance theme note restart" Classes="label" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Text="Applies immediately across every open window." />
                </StackPanel>

                <StackPanel x:Name="ViewportSection">
                    <TextBlock Text="Viewport" Classes="section" />
                    <Grid Tag="viewport overhang tint angle threshold degrees" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Overhang tint angle" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="OverhangAngleDegrees" Unit="°" UnitKind="Scalar" Step="1" Grid.Column="1" Minimum="10" Maximum="89"
                                Value="{Binding OverhangAngleDegrees, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="10" Maximum="89" Increment="1" FormatString="0"
                                       Value="{Binding OverhangAngleDegrees, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Faces that lean down more than this from vertical are tinted as overhangs in the viewport. It is a reading aid only: generation uses the overhang angle in the support settings." />
                    <Grid Tag="viewport model support shadows off working presentation" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Model shadows" Classes="label" />
                        <ComboBox x:Name="SettingsShadowMode" Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{Binding ModelShadowModes}" SelectedIndex="{Binding ModelShadowModeIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid Tag="viewport shadows working strength" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Working strength" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="WorkingShadowStrength" Grid.Column="1" Height="24" UnitKind="Scalar" Unit="" Minimum="0" Maximum="0.7" Step="0.05" Format="0.00" Value="{Binding WorkingShadowStrength, Mode=TwoWay}" />
                    </Grid>
                    <Grid Tag="viewport shadows working softness" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Working softness" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="WorkingShadowSoftnessMm" Grid.Column="1" Height="24" UnitKind="Length" Unit="mm" Minimum="0" Maximum="4" Step="0.1" Format="0.00" Value="{Binding WorkingShadowSoftnessMm, Mode=TwoWay}" />
                    </Grid>
                    <Grid Tag="viewport shadows presentation strength" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Presentation strength" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="PresentationShadowStrength" Grid.Column="1" Height="24" UnitKind="Scalar" Unit="" Minimum="0" Maximum="0.7" Step="0.05" Format="0.00" Value="{Binding PresentationShadowStrength, Mode=TwoWay}" />
                    </Grid>
                    <Grid Tag="viewport shadows presentation softness" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Presentation softness" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="PresentationShadowSoftnessMm" Grid.Column="1" Height="24" UnitKind="Length" Unit="mm" Minimum="0" Maximum="4" Step="0.1" Format="0.00" Value="{Binding PresentationShadowSoftnessMm, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Working is subtle; Presentation is stronger. Each remembers its strength and softness. Choose Off to disable model shadows. Settings apply immediately and are shared with View settings." />
                    <CheckBox Tag="viewport ambient occlusion AO contact depth enabled off" Content="Contact depth (AO)" IsChecked="{Binding AmbientOcclusionEnabled, Mode=TwoWay}" Margin="0,4" />
                    <Grid Tag="viewport ambient occlusion AO contact strength" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Contact depth strength" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="AmbientOcclusionStrength" Grid.Column="1" Height="24" UnitKind="Scalar" Unit="" Minimum="0" Maximum="0.6" Step="0.05" Format="0.00" Value="{Binding AmbientOcclusionStrength, Mode=TwoWay}" />
                    </Grid>
                    <Grid Tag="viewport ambient occlusion AO contact radius" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Contact radius (mm)" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="AmbientOcclusionRadiusMm" Grid.Column="1" Height="24" UnitKind="Length" Unit="mm" Minimum="0.1" Maximum="10" Step="0.1" Format="0.0" Value="{Binding AmbientOcclusionRadiusMm, Mode=TwoWay}" />
                    </Grid>
                    <CheckBox Tag="viewport plate reflections enabled off" Content="Plate reflections" IsChecked="{Binding PlateReflectionsEnabled, Mode=TwoWay}" Margin="0,4" />
                    <Grid Tag="viewport plate reflections strength" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Plate reflection strength" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="PlateReflectionStrength" Grid.Column="1" Height="24" UnitKind="Scalar" Unit="" Minimum="0" Maximum="0.3" Step="0.01" Format="0.00" Value="{Binding PlateReflectionStrength, Mode=TwoWay}" />
                    </Grid>
                    <CheckBox Tag="viewport plate shadows enabled off" Content="Plate shadows" IsChecked="{Binding PlateShadowsEnabled, Mode=TwoWay}" Margin="0,4" />
                    <Grid Tag="viewport outline border width pixels deferred" ColumnDefinitions="240,*" Margin="0,3">
                        <TextBlock Text="Object border width (px, Deferred)" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="OutlineWidthPixels" Grid.Column="1" UnitKind="Scalar" Unit="px" Minimum="1" Maximum="5" Step="0.25" Value="{Binding OutlineWidthPixels, Mode=TwoWay}" />
                    </Grid>
                    <CheckBox Tag="viewport cavity shading enabled off" Content="Cavity shading" IsChecked="{Binding CavityEnabled, Mode=TwoWay}" Margin="0,4" />
                    <Grid Tag="viewport cavity cavity ridge strength" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Cavity ridge strength" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="CavityRidgeStrength" Grid.Column="1" Height="24" UnitKind="Scalar" Unit="" Minimum="0" Maximum="4" Step="0.05" Format="0.00" Value="{Binding CavityRidgeStrength, Mode=TwoWay}" />
                    </Grid>
                    <Grid Tag="viewport cavity cavity valley strength" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Cavity valley strength" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="CavityValleyStrength" Grid.Column="1" Height="24" UnitKind="Scalar" Unit="" Minimum="0" Maximum="4" Step="0.05" Format="0.00" Value="{Binding CavityValleyStrength, Mode=TwoWay}" />
                    </Grid>
                    <Grid Tag="viewport cavity cavity radius (px)" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Cavity radius (px)" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="CavityRadiusPixels" Grid.Column="1" Height="24" UnitKind="Scalar" Unit="" Minimum="0.5" Maximum="8" Step="0.5" Format="0.00" Value="{Binding CavityRadiusPixels, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Contact depth works on opaque models and supports in deferred shading. AO and cavity can be switched off independently. Reflections work on both render paths; the plate surface always disappears below." />
                    <Grid Tag="viewport plate bed transparency opacity below underneath" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Plate perimeter below" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="PlateOpacityFromBelow" Unit="" UnitKind="Scalar" Step="0.01" Grid.Column="1" Minimum="0" Maximum="1"
                                Value="{Binding PlateOpacityFromBelow, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00"
                                       Value="{Binding PlateOpacityFromBelow, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Opacity of the perimeter below the plate. Set to 0 to hide it. The plate surface, grid and reflections disappear below." />
                    <Grid Tag="viewport overhang checker colour color picker first" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Overhang colour A" Classes="label" />
                        <ColorPicker Grid.Column="1" HorizontalAlignment="Left" MinWidth="110"
                                     IsAlphaEnabled="False" IsAlphaVisible="False"
                                     Color="{Binding OverhangColorA, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="The two colours of the overhang tint's checker pattern; the checker makes the tinted area's slope and size easier to judge than a flat colour." />
                    <Grid Tag="viewport overhang checker colour color picker second" ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Text="Overhang colour B" Classes="label" />
                        <ColorPicker Grid.Column="1" HorizontalAlignment="Left" MinWidth="110"
                                     IsAlphaEnabled="False" IsAlphaVisible="False"
                                     Color="{Binding OverhangColorB, Mode=TwoWay}" />
                    </Grid>
                    <Grid Tag="viewport overhang checker chequer square cell size mm" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Overhang checker size" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="OverhangCheckerSizeMm" Unit="mm" UnitKind="Scalar" Step="0.5" Grid.Column="1" Minimum="0.5" Maximum="20"
                                Value="{Binding OverhangCheckerSizeMm, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="0.5" Maximum="20" Increment="0.5" FormatString="0.0"
                                       Value="{Binding OverhangCheckerSizeMm, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Size of each square of that checker, mm on the model." />
                    <CheckBox Tag="viewport view cube orientation navigation enabled off" Content="Show orientation cube" IsChecked="{Binding ViewCubeEnabled, Mode=TwoWay}" Margin="0,4" />
                    <Grid Tag="viewport view cube corner navigation size pixels" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="View cube size" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="ViewCubeSizePixels" Unit="px" UnitKind="Scalar" Step="8" IsInteger="True" Grid.Column="1" Minimum="48" Maximum="192"
                                Value="{Binding ViewCubeSizePixels, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="48" Maximum="192" Increment="8" FormatString="0"
                                       Value="{Binding ViewCubeSizePixels, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Size of the orientation cube in the viewport's top-right corner, pixels. Click a face for that view, drag it to orbit." />
                    <Grid Tag="viewport support edit gizmo handle size pixels" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Support gizmo size" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="SupportGizmoSizePixels" Unit="px" UnitKind="Scalar" Step="8" IsInteger="True" Grid.Column="1" Minimum="24" Maximum="400"
                                Value="{Binding SupportGizmoSizePixels, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="24" Maximum="400" Increment="8" FormatString="0"
                                       Value="{Binding SupportGizmoSizePixels, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Size of the transform gizmos drawn on a support's handles in edit mode (Space in Support mode), pixels on screen." />
                    <Grid Tag="viewport support edit gizmo line width thickness pixels" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Support gizmo line width" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="SupportGizmoLineWidth" Unit="px" UnitKind="Scalar" Step="0.5" Grid.Column="1" Minimum="1" Maximum="12"
                                Value="{Binding SupportGizmoLineWidth, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="1" Maximum="12" Increment="0.5" FormatString="0.0"
                                       Value="{Binding SupportGizmoLineWidth, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Stroke width of those gizmos, pixels." />
                </StackPanel>

                <StackPanel x:Name="KeymapSection">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Keymap" Classes="section" />
                        <Button Grid.Column="1" Content="Reset all" Command="{Binding Keymap.ResetAllCommand}"
                                Padding="10,3" Margin="0,8,0,4" />
                    </Grid>
                    <TextBlock Classes="label" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Window-level shortcuts only. Viewport G/R/S/T/H/F keys and axis constraints remain fixed." />
                    <TextBlock Text="{Binding Keymap.ValidationMessage}" IsVisible="{Binding Keymap.HasValidationMessage}"
                               Foreground="{DynamicResource AppAccent}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Keymap.Bindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeymapBindingViewModel">
                                <Grid IsVisible="{Binding IsVisible}" ColumnDefinitions="*,150,70" ColumnSpacing="8" Margin="0,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActionName}" Classes="label" />
                                        <TextBlock Text="{Binding ActionId}" Foreground="#666C72" FontSize="10" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding CaptureButtonText}"
                                            Command="{Binding BeginCaptureCommand}" MinHeight="28"
                                            HorizontalContentAlignment="Center" />
                                    <Button Grid.Column="2" Content="Reset" Command="{Binding ResetCommand}"
                                            MinHeight="28" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="PrintersSection">
                    <TextBlock Text="Printers" Classes="section" />
                    <Grid Tag="printers machines definitions add duplicate rename delete resolution display size mirror format"
                          ColumnDefinitions="190,*" ColumnSpacing="14">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Printers.Items}"
                                     SelectedIndex="{Binding Printers.SelectedIndex, Mode=TwoWay}"
                                     MinHeight="180" MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="printers:PrinterDefinition">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                            <TextBlock Text="Built-in" Classes="label" FontSize="10"
                                                       IsVisible="{Binding IsBuiltIn}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Add" Command="{Binding Printers.AddCommand}" Margin="0,0,4,4" />
                                <Button Content="Duplicate" Command="{Binding Printers.DuplicateCommand}" Margin="0,0,4,4" />
                                <Button Content="Delete" Command="{Binding Printers.DeleteCommand}" Margin="0,0,4,4" />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" IsEnabled="{Binding Printers.HasSelectedPrinter}">
                            <TextBlock Text="{Binding Printers.CompatibilityNote}" Classes="label"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Printers.FormatStatus}" Classes="label"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Classes="label" TextWrapping="Wrap" Margin="0,0,0,6"
                                       IsVisible="{Binding Printers.IsBuiltInSelected}"
                                       Text="Built-in definitions are read-only. The first edit creates a user copy." />
                            <Grid ColumnDefinitions="130,*,Auto" ColumnSpacing="6" Margin="0,2">
                                <TextBlock Text="Name" Classes="label" />
                                <TextBox Grid.Column="1" Text="{Binding Printers.NameDraft}" />
                                <Button Grid.Column="2" Content="Rename" Command="{Binding Printers.RenameCommand}" />
                            </Grid>
                    <TextBlock Classes="hint" Text="How the printer is listed in Danslicer and saved with the project." />
                            <Grid ColumnDefinitions="130,*" Margin="0,2">
                                <TextBlock Text="Machine name" Classes="label" />
                                <TextBox Grid.Column="1" Text="{Binding Printers.MachineName, Mode=TwoWay}" />
                            </Grid>
                    <TextBlock Classes="hint" Text="The name written into the print file's header. Some printers refuse a file whose machine name is not their own." />
                            <Grid ColumnDefinitions="130,*" Margin="0,2">
                                <TextBlock Text="File extension" Classes="label" />
                                <TextBox Grid.Column="1" Text="{Binding Printers.FileExtension, Mode=TwoWay}" />
                            </Grid>
                    <TextBlock Classes="hint" Text="Native export checks the extension and format version together. Unsupported combinations cannot be exported." />
                            <ItemsControl ItemsSource="{Binding Printers.Fields}"
                                          ItemTemplate="{StaticResource PrinterFieldTemplate}" />
                            <TextBlock Classes="hint" Text="Display dimensions set pixel scale. Print width and depth limit the usable area at the centre of that display." />
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="Mirror layer image" Classes="label" Width="130" />
                                <CheckBox Content="X" IsChecked="{Binding Printers.MirrorX}" Margin="0,0,12,0" />
                                <CheckBox Content="Y" IsChecked="{Binding Printers.MirrorY}" />
                            </WrapPanel>
                            <TextBlock Classes="hint" Text="Flip every layer image on that axis before writing, for printers whose screen is mirrored relative to the plate. Wrong here prints a mirrored model." />
                            <TextBlock Text="{Binding Printers.ValidationMessage}"
                                       IsVisible="{Binding Printers.HasValidationMessage}"
                                       Foreground="{DynamicResource AppAccent}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="ResinsSection">
                    <TextBlock Text="Resins" Classes="section" />
                    <Grid Tag="resin presets exposure cure bottom layers lift retract light off delay"
                          ColumnDefinitions="190,*" ColumnSpacing="14">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Resins.DisplayNames}"
                                     SelectedIndex="{Binding Resins.SelectedIndex, Mode=TwoWay}"
                                     MinHeight="150" MaxHeight="260" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Save" Command="{Binding Resins.SaveCommand}" Margin="0,0,4,4" />
                                <Button Content="Save As…" Command="{Binding Resins.BeginSaveAsCommand}" Margin="0,0,4,4" />
                                <Button Content="Rename" Command="{Binding Resins.BeginRenameCommand}" Margin="0,0,4,4" />
                                <Button Content="Delete" Command="{Binding Resins.DeleteCommand}" Margin="0,0,4,4" />
                            </WrapPanel>
                            <StackPanel IsVisible="{Binding Resins.IsNameEditorVisible}" Margin="0,4,0,0">
                                <TextBox Text="{Binding Resins.NameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Preset name" />
                                <TextBlock Text="{Binding Resins.ValidationMessage}"
                                           IsVisible="{Binding Resins.HasValidationMessage}"
                                           Foreground="{DynamicResource AppAccent}" FontSize="12" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="{Binding Resins.NameEditorAction}"
                                            Command="{Binding Resins.ConfirmNameCommand}" Margin="0,0,4,0" />
                                    <Button Content="Cancel" Command="{Binding Resins.CancelNameCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="label" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Applying a resin changes cure and peel settings only. Layer height, anti-aliasing and XY compensation remain per-print." />
                            <ItemsControl ItemsSource="{Binding Resins.Fields}"
                                          ItemTemplate="{StaticResource PrinterFieldTemplate}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="SupportsSection">
                    <TextBlock Text="Supports" Classes="section" />
                    <TextBlock Classes="hint" Text="The recipe every generation, placement, parenting and bracing uses; the same settings as the Support settings pop-out in Support mode. Hover any setting for what it does. Presets snapshot the whole recipe." />
                    <controls:SupportSettingsView DataContext="{Binding}" />
                </StackPanel>

                <StackPanel x:Name="ExternalToolsSection">
                    <TextBlock Text="External tools" Classes="section" />
                    <Grid Tag="external tools uvtools executable application path browse validation"
                          ColumnDefinitions="190,*,Auto" ColumnSpacing="6" Margin="0,2">
                        <TextBlock Text="UVtools executable" Classes="label" ToolTip.Tip="Path to UVtools, used by the UV check button in Slicing to open the exported file." />
                        <TextBox Grid.Column="1"
                                 Text="{Binding UvtoolsExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Path to UVtools" />
                        <Button Grid.Column="2" Content="Browse…" Click="OnBrowseUvtoolsClick" />
                    </Grid>
                    <TextBlock Text="{Binding UvtoolsExecutablePathValidationMessage}"
                               Foreground="#FFB35C" FontSize="12" Margin="190,4,0,0"
                               IsVisible="{Binding !IsUvtoolsExecutablePathValid}" />
                    <TextBlock Text="{Binding UvtoolsExecutablePathValidationMessage}"
                               Foreground="#78C68A" FontSize="12" Margin="190,4,0,0"
                               IsVisible="{Binding IsUvtoolsExecutablePathValid}" />
                    <TextBlock Classes="label" TextWrapping="Wrap" Margin="190,4,0,0"
                               Text="Danslicer opens exported files in your installed copy; UVtools is not bundled." />
                </StackPanel>

                <StackPanel x:Name="SpaceMouseSection">
                    <TextBlock Text="SpaceMouse" Classes="section" />
                    <TextBlock Tag="spacemouse note live" Classes="label" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Changes apply immediately — tune while moving the cap. Sensitivity 1.00 is the untuned default." />
                    <Grid Tag="spacemouse orbit rotate sensitivity speed" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Orbit sensitivity" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="SpaceMouseOrbitSensitivity" Unit="" UnitKind="Scalar" Step="0.01" Grid.Column="1" Minimum="0.02" Maximum="4" Value="{Binding SpaceMouseOrbitSensitivity, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="0.02" Maximum="4" Increment="0.05" FormatString="0.00"
                                       Value="{Binding SpaceMouseOrbitSensitivity, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Multiplier on how fast a tilt or twist of the cap orbits the view." />
                    <Grid Tag="spacemouse pan slide sensitivity speed" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Pan sensitivity" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="SpaceMousePanSensitivity" Unit="" UnitKind="Scalar" Step="0.01" Grid.Column="1" Minimum="0.02" Maximum="4" Value="{Binding SpaceMousePanSensitivity, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="0.02" Maximum="4" Increment="0.05" FormatString="0.00"
                                       Value="{Binding SpaceMousePanSensitivity, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Multiplier on how fast sliding the cap pans the view." />
                    <Grid Tag="spacemouse zoom push sensitivity speed" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Zoom sensitivity" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="SpaceMouseZoomSensitivity" Unit="" UnitKind="Scalar" Step="0.01" Grid.Column="1" Minimum="0.02" Maximum="4" Value="{Binding SpaceMouseZoomSensitivity, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="0.02" Maximum="4" Increment="0.05" FormatString="0.00"
                                       Value="{Binding SpaceMouseZoomSensitivity, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Multiplier on how fast pushing or pulling the cap zooms." />
                    <Grid Tag="spacemouse deadzone drift threshold" ColumnDefinitions="190,*,110" Margin="0,2">
                        <TextBlock Text="Deadzone" Classes="label" />
                        <refresh:FilledNumericSlider PreviewProperty="SpaceMouseDeadzone" Unit="" UnitKind="Scalar" Step="0.01" Grid.Column="1" Minimum="0" Maximum="0.2" Value="{Binding SpaceMouseDeadzone, Mode=TwoWay}" />
                        <NumericUpDown Grid.Column="2" Minimum="0" Maximum="0.2" Increment="0.005" FormatString="0.000"
                                       Value="{Binding SpaceMouseDeadzone, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Cap movement below this fraction of full deflection is ignored, so a resting cap does not drift the view." />
                    <StackPanel Tag="spacemouse invert orbit yaw pitch direction flip" Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                        <TextBlock Text="Invert orbit" Classes="label" Width="174" />
                        <CheckBox Content="Yaw (twist)" IsChecked="{Binding SpaceMouseInvertOrbitYaw, Mode=TwoWay}" />
                        <CheckBox Content="Pitch (tilt)" IsChecked="{Binding SpaceMouseInvertOrbitPitch, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="Reverse the direction of a twist (yaw) or tilt (pitch) of the cap." />
                    <StackPanel Tag="spacemouse invert pan direction flip horizontal vertical" Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                        <TextBlock Text="Invert pan" Classes="label" Width="174" />
                        <CheckBox Content="X (left/right)" IsChecked="{Binding SpaceMouseInvertPanX, Mode=TwoWay}" />
                        <CheckBox Content="Y (up/down)" IsChecked="{Binding SpaceMouseInvertPanY, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="Reverse the direction the view pans when the cap slides left/right or up/down." />
                    <StackPanel Tag="spacemouse invert zoom push pull direction flip" Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                        <TextBlock Text="Invert zoom" Classes="label" Width="174" />
                        <CheckBox Content="Push/pull" IsChecked="{Binding SpaceMouseInvertZoom, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="Reverse push and pull." />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
