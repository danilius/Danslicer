<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Forge: graphite depth, cool neutral text, and one tool-oriented amber accent. -->
    <SolidColorBrush x:Key="DsBackgroundBrush" Color="#12161B" />
    <SolidColorBrush x:Key="DsBackgroundDeepBrush" Color="#0D1116" />
    <SolidColorBrush x:Key="DsSurfaceBrush" Color="#181E25" />
    <SolidColorBrush x:Key="DsSurfaceRaisedBrush" Color="#202833" />
    <SolidColorBrush x:Key="DsOverlayBrush" Color="#F2161C22" />
    <SolidColorBrush x:Key="DsBorderBrush" Color="#2D3742" />
    <SolidColorBrush x:Key="DsBorderStrongBrush" Color="#526170" />
    <SolidColorBrush x:Key="DsTextPrimaryBrush" Color="#E6EDF3" />
    <SolidColorBrush x:Key="DsTextSecondaryBrush" Color="#A7B1BC" />
    <SolidColorBrush x:Key="DsTextMutedBrush" Color="#6F7A86" />
    <SolidColorBrush x:Key="DsAccentBrush" Color="#F59E42" />
    <SolidColorBrush x:Key="DsAccentHoverBrush" Color="#FFB15F" />
    <SolidColorBrush x:Key="DsAccentPressedBrush" Color="#D77D28" />
    <SolidColorBrush x:Key="DsSuccessBrush" Color="#4CC38A" />
    <SolidColorBrush x:Key="DsWarningBrush" Color="#F2C14E" />
    <SolidColorBrush x:Key="DsDangerBrush" Color="#FF6B6B" />
</ResourceDictionary>
