<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The original Danslicer palette, kept as a first-class runtime theme. -->
    <SolidColorBrush x:Key="DsBackgroundBrush" Color="#23262A" />
    <SolidColorBrush x:Key="DsBackgroundDeepBrush" Color="#17191C" />
    <SolidColorBrush x:Key="DsSurfaceBrush" Color="#1F2124" />
    <SolidColorBrush x:Key="DsSurfaceRaisedBrush" Color="#2B2F34" />
    <SolidColorBrush x:Key="DsOverlayBrush" Color="#F523262A" />
    <SolidColorBrush x:Key="DsBorderBrush" Color="#111111" />
    <SolidColorBrush x:Key="DsBorderStrongBrush" Color="#7A858F" />
    <SolidColorBrush x:Key="DsTextPrimaryBrush" Color="#E0E3E7" />
    <SolidColorBrush x:Key="DsTextSecondaryBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="DsTextMutedBrush" Color="#666C72" />
    <SolidColorBrush x:Key="DsAccentBrush" Color="#E39032" />
    <SolidColorBrush x:Key="DsAccentHoverBrush" Color="#F0A347" />
    <SolidColorBrush x:Key="DsAccentPressedBrush" Color="#C97824" />
    <SolidColorBrush x:Key="DsSuccessBrush" Color="#78C68A" />
    <SolidColorBrush x:Key="DsWarningBrush" Color="#FFB35C" />
    <SolidColorBrush x:Key="DsDangerBrush" Color="#EF5350" />
</ResourceDictionary>
