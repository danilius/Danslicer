<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:refresh="using:Danslicer.App.Controls.Refresh"
             xmlns:vm="using:Danslicer.App.ViewModels"
             x:Class="Danslicer.App.Controls.SupportSettingsView"
             x:DataType="vm:ConfigViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextFaint}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <StackPanel Margin="0,0,0,6" IsVisible="{Binding ShowSupportPresetControls}">
            <TextBlock Text="Preset" Classes="label" Margin="0,0,0,2" ToolTip.Tip="A named snapshot of every support setting. Save keeps the current values in the selected preset; Save As makes a new one." />
            <Grid ColumnDefinitions="*,Auto">
                <ComboBox ItemsSource="{Binding SupportPresetDisplayNames}"
                          SelectedIndex="{Binding SelectedSupportPresetIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="Edit…" Command="{Binding EditSupportPresetCommand}"
                        Margin="4,0,0,0" ToolTip.Tip="Edit this preset with a live 3D preview" />
            </Grid>
            <WrapPanel Margin="0,4,0,0">
                <Button Content="Save" Command="{Binding SaveSupportPresetCommand}" Margin="0,0,4,0"
                        ToolTip.Tip="Overwrite this preset with the current support settings" />
                <Button Content="Save As…" Command="{Binding BeginSaveSupportPresetAsCommand}" Margin="0,0,4,0" />
                <Button Content="Rename" Command="{Binding BeginRenameSupportPresetCommand}" Margin="0,0,4,0" />
                <Button Content="Delete" Command="{Binding DeleteSupportPresetCommand}" />
            </WrapPanel>
            <StackPanel IsVisible="{Binding IsSupportPresetNameEditorVisible}" Margin="0,4,0,0">
                <TextBox Text="{Binding SupportPresetNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Preset name" />
                <TextBlock Text="{Binding SupportPresetValidationMessage}"
                           IsVisible="{Binding HasSupportPresetValidationMessage}"
                           Foreground="#EF5350" FontSize="11" Margin="0,2,0,0" />
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="{Binding SupportPresetNameEditorAction}"
                            Command="{Binding ConfirmSupportPresetNameCommand}" Margin="0,0,4,0" />
                    <Button Content="Cancel" Command="{Binding CancelSupportPresetNameCommand}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>

        <Expander Header="Tip" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <Grid Tag="supports tip contact diameter mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Tip diameter" Classes="label" ToolTip.Tip="Diameter of the tip's end where it meets the model, mm. Smaller leaves a smaller mark and holds less." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="100" Step="0.05" Format="0.##"
                                   Value="{Binding SupportTipDiameter, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports tip ball snap diameter none zero mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Ball diameter (0 = none)" Classes="label" ToolTip.Tip="A sphere at the very tip, mm, for a rounder contact that snaps off cleanly. 0 = the cone ends flat." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="100" Step="0.05" Format="0.##"
                                   Value="{Binding SupportBallDiameter, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports tip penetration depth embedding mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Penetration depth" Classes="label" ToolTip.Tip="How far the tip sinks into the model surface along its axis, mm, so the contact bonds rather than touches." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="100" Step="0.05" Format="0.##"
                                   Value="{Binding SupportPenetrationDepth, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="Members" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <Grid Tag="supports members trunk diameter mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Trunk diameter" Classes="label" ToolTip.Tip="Diameter of the vertical member rising from the base, mm." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="100" Step="0.05" Format="0.##"
                                   Value="{Binding SupportTrunkDiameter, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports members branch diameter mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Branch diameter" Classes="label" ToolTip.Tip="Diameter of the angled members that carry tips to a trunk, mm." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="100" Step="0.05" Format="0.##"
                                   Value="{Binding SupportBranchDiameter, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports members angle degrees maximum" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Member angle °" Classes="label" ToolTip.Tip="The most any angled member (branch or tip cone) may lean from vertical, degrees. 45 is what a resin print holds without sagging." />
                    <refresh:FilledNumericSlider UnitKind="Angle" Unit="°" Grid.Column="1" Minimum="1" Maximum="89" Step="1" Format="0"
                                   Value="{Binding SupportMemberAngleDegrees, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports members tip member length mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Cone length" Classes="label" ToolTip.Tip="Length of the cone from the tip's end back to where it joins its branch or trunk, mm." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="100" Step="0.1" Format="0.##"
                                   Value="{Binding SupportTipMemberLength, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports members maximum branch length mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max branch length" Classes="label" ToolTip.Tip="The longest branch the router will lay from a tip to a trunk, mm; a tip further than this gets its own trunk." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="1000" Step="0.5" Format="0.##"
                                   Value="{Binding SupportMaxBranchLength, Mode=TwoWay}" />
                </Grid>
                <CheckBox Tag="supports members prefer existing trunks branch first" Content="Prefer existing trunks"
                          IsChecked="{Binding SupportPreferExistingTrunks, Mode=TwoWay}" Margin="0,4" />
                <CheckBox Tag="supports manual independent ignore existing overlap intersection"
                          Content="Independent supports (ignore existing)"
                          ToolTip.Tip="Manual T placements ignore other supports but still avoid models"
                          IsChecked="{Binding SupportIndependentManualSupports, Mode=TwoWay}" Margin="0,4" />
                <Grid Tag="supports members existing trunk branch range mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Existing trunk range" Classes="label" ToolTip.Tip="How far around a new tip the router looks for a trunk already standing to branch onto, mm." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="1000" Step="0.5" Format="0.##"
                                   Value="{Binding SupportExistingTrunkBranchRange, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports members minimum surface gap separation mm disabled zero"
                      ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Min surface gap" Classes="label" ToolTip.Tip="Minimum gap between the surfaces of members that do not meet, mm, so neighbours do not fuse. 0 = no rule." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="100" Step="0.1" Format="0.##"
                                   Value="{Binding SupportMinMemberSeparationMm, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports members minimum branch attach height above plate mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Min branch height" Classes="label"
                               ToolTip.Tip="No branch joins a trunk, and no junction is made, below this height above the plate" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="500" Step="1" Format="0.##"
                                   Value="{Binding SupportMinBranchAttachHeightMm, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="Base" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <Grid Tag="supports base shape disc cone none" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Shape" Classes="label" ToolTip.Tip="Disc: a flat disc on the plate. Disc + cone: the disc with a cone up to the trunk. None: the trunk ends on the plate." />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SupportBaseShapes}"
                              SelectedItem="{Binding SupportBaseShapeValue, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports base diameter mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Base diameter" Classes="label" ToolTip.Tip="Diameter of the base disc on the plate, mm. Bases never shrink to fit; a base that would hit the model moves instead." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="100" Step="0.1" Format="0.##"
                                   Value="{Binding SupportBaseDiameter, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports base height thickness mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Base height" Classes="label" ToolTip.Tip="Height of the base disc, mm." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="100" Step="0.1" Format="0.##"
                                   Value="{Binding SupportBaseHeight, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports base cone height mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Base cone height" Classes="label" ToolTip.Tip="Height of the cone from the disc up to the trunk diameter (Disc + cone), mm." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="100" Step="0.1" Format="0.##"
                                   Value="{Binding SupportBaseConeHeight, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="Grid" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <CheckBox Tag="supports base grid enable disable free placement" Content="Use base grid"
                          IsChecked="{Binding SupportUseBaseGrid, Mode=TwoWay}" Margin="0,4" />
                <Grid Tag="supports base square grid pitch spacing mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Grid pitch" Classes="label" ToolTip.Tip="Spacing of the imaginary grid bases snap to, mm. Coarser gives a tidier forest, finer reaches more tips." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="1000" Step="1" Format="0.##"
                                   Value="{Binding SupportBaseGridPitch, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="Reinforce" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <CheckBox Tag="supports reinforce growth rule enable disable ring contacts"
                          Content="Enable reinforcement"
                          IsChecked="{Binding SupportReinforceEnabled, Mode=TwoWay}" Margin="0,4" />
                <Grid Tag="supports reinforce seed selection object region critical tips"
                      ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Seed selector" Classes="label" ToolTip.Tip="Where the reinforcing ring is centred: the lowest point of the object, or of each island." />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ReinforceSeedSelectors}"
                              SelectedItem="{Binding SupportReinforceSeedSelector, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports reinforce ring contact count" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Ring tip count" Classes="label" ToolTip.Tip="How many extra tips the ring places around the seed." />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="" IsInteger="True" Grid.Column="1" Minimum="1" Maximum="100" Step="1" Format="0"
                                   Value="{Binding SupportReinforceCount, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports reinforce ring radius mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Ring radius" Classes="label" ToolTip.Tip="Radius of the ring of extra tips around the seed, mm." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="1000" Step="0.1" Format="0.##"
                                   Value="{Binding SupportReinforceRingRadius, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports reinforce ring tip diameter multiplier"
                      ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Tip diameter multiplier" Classes="label" ToolTip.Tip="The ring's tips use the tip diameter times this: heavier tips where the print starts." />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="×" Grid.Column="1" Minimum="0.01" Maximum="100" Step="0.05" Format="0.##"
                                   Value="{Binding SupportReinforceRingDiameterMultiplier, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>

        <!-- Guided placement: line (L), polygon (P), edge (E), ring (R), contour (C), densify (D)
             and thin (Shift+D). SUPPORT-GEOMETRY-SPEC "Guided tip placement". -->
        <Expander Header="Guided" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <CheckBox Tag="supports guided line polygon edge ring contour ignore existing"
                          Content="Guided tools ignore existing"
                          ToolTip.Tip="Guided tools place every tip and route as if no other support existed. Untick to keep clear of existing tips and route around existing supports."
                          IsChecked="{Binding SupportGuidedIgnoreExistingSupports, Mode=TwoWay}" Margin="0,4" />
                <Grid Tag="supports guided existing tip clearance distance mm" ColumnDefinitions="170,*" Margin="0,2"
                      IsEnabled="{Binding !SupportGuidedIgnoreExistingSupports}">
                    <TextBlock Text="Guided tip clearance" Classes="label"
                               ToolTip.Tip="When guided tools respect existing supports: no guided tip closer than this to an existing tip" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.1" Maximum="100" Step="0.5" Format="0.##"
                                   Value="{Binding SupportGuidedExistingClearanceMm, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports guided densify insert tips between neighbours count" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Densify: tips per gap" Classes="label"
                               ToolTip.Tip="D inserts this many tips along the surface between each pair of neighbouring selected tips (all of the model's tips when nothing is selected)" />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="" IsInteger="True" Grid.Column="1" Minimum="1" Maximum="10" Step="1" Format="0"
                                   Value="{Binding SupportGuidedDensifyInsertions, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports guided thin keep one in every n tips" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Thin: keep 1 in" Classes="label"
                               ToolTip.Tip="Shift+D keeps one tip in this many along each run of selected tips and removes the rest with their supports" />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="" IsInteger="True" Grid.Column="1" Minimum="2" Maximum="10" Step="1" Format="0"
                                   Value="{Binding SupportGuidedThinKeepEvery, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>

        <!-- Parenting (J): SUPPORT-GEOMETRY-SPEC "Parenting". Zero means the Members value. -->
        <Expander Header="Parenting" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <TextBlock Text="J re-routes the selected supports together so branches share trunks. 0 = use the Members value."
                           Classes="label" TextWrapping="Wrap" Margin="0,0,0,4" />
                <CheckBox Tag="supports parenting hierarchical tree junctions pair"
                          Content="Hierarchical tree"
                          ToolTip.Tip="Tips pair into junctions, junctions pair again, one trunk carries the lot. Off: each tip joins a trunk directly."
                          IsChecked="{Binding SupportParentingHierarchical, Mode=TwoWay}" Margin="0,4" />
                <CheckBox Tag="supports parenting auto automatic after placement live"
                          Content="Auto-parenting"
                          ToolTip.Tip="After T, a guided tool or densify, the new supports and their neighbours within the trunk search range are parented at once, as part of the same undo step. Off: supports stay single until J."
                          IsChecked="{Binding SupportAutoParenting, Mode=TwoWay}" Margin="0,4" />
                <Grid Tag="supports parenting max branch length mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max branch length" Classes="label" ToolTip.Tip="How far a tip may reach to join a trunk when parented (J), mm. 0 = the Members value." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="1000" Step="0.5" Format="0.##"
                                   Value="{Binding SupportParentingMaxBranchLength, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports parenting max branch angle degrees" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max branch angle °" Classes="label" ToolTip.Tip="The steepest branch parenting may lay, degrees from vertical; shallower keeps branches short and stiff. 0 = the Members value." />
                    <refresh:FilledNumericSlider UnitKind="Angle" Unit="°" Grid.Column="1" Minimum="0" Maximum="89" Step="1" Format="0"
                                   Value="{Binding SupportParentingMaxBranchAngle, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports parenting trunk search range mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Trunk search range" Classes="label" ToolTip.Tip="How far around a tip parenting looks for a trunk to join before raising its own, mm. 0 = the Members existing trunk range." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="1000" Step="0.5" Format="0.##"
                                   Value="{Binding SupportParentingTrunkRange, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports parenting minimum tips per trunk" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Min tips per trunk" Classes="label"
                               ToolTip.Tip="A new trunk carrying fewer tips than this gets one more try with double range" />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="" IsInteger="True" Grid.Column="1" Minimum="1" Maximum="20" Step="1" Format="0"
                                   Value="{Binding SupportParentingMinTipsPerTrunk, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports parenting rounds seeds" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Rounds" Classes="label"
                               ToolTip.Tip="Re-route this many times with different seeds; the round with the fewest trunks wins" />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="" IsInteger="True" Grid.Column="1" Minimum="1" Maximum="10" Step="1" Format="0"
                                   Value="{Binding SupportParentingRounds, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports parenting max cone bend degrees lateral join" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max cone bend °" Classes="label"
                               ToolTip.Tip="How far the branch leaving a cone may bend from the cone's axis. 0 = the member angle. A cone on a leaning wall points outward, so joining a trunk sideways along the edge needs 60–90." />
                    <refresh:FilledNumericSlider UnitKind="Angle" Unit="°" Grid.Column="1" Minimum="0" Maximum="180" Step="5" Format="0"
                                   Value="{Binding SupportParentingMaxConeBend, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports parenting max branches per trunk" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max branches per trunk" Classes="label"
                               ToolTip.Tip="How many branches one trunk may carry when parented. 0 = the growth rule's default (6)." />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="" IsInteger="True" Grid.Column="1" Minimum="0" Maximum="200" Step="1" Format="0"
                                   Value="{Binding SupportParentingMaxBranchesPerTrunk, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="Bracing" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <TextBlock Text="K ties neighbouring supports together with zigzag braces, pair after pair along the row; Shift+K removes them. With exactly two supports selected, K braces just those two. 0 = use the Members value."
                           Classes="label" TextWrapping="Wrap" Margin="0,0,0,4" />
                <CheckBox Tag="supports bracing auto automatic after generation parenting"
                          Content="Auto-bracing"
                          ToolTip.Tip="Brace after Generate Supports and after every parenting, as part of that command's undo step. Off: braces exist only when you press K."
                          IsChecked="{Binding SupportAutoBracing, Mode=TwoWay}" Margin="0,4" />
                <Grid Tag="supports bracing pattern zigzag diagonal" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Pattern" Classes="label"
                               ToolTip.Tip="Zigzag: each brace leaves the trunk the previous one arrived at. Diagonal: every brace leans the same way." />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BracingPatterns}"
                              SelectedItem="{Binding SupportBracingPattern, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing brace diameter mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Brace diameter" Classes="label" ToolTip.Tip="0 = the branch diameter" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="20" Step="0.1" Format="0.##"
                                   Value="{Binding SupportBracingDiameter, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing angle degrees" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max brace angle °" Classes="label" ToolTip.Tip="The most a brace may lean from vertical. A rung that cannot fit at this angle is left out rather than laid flatter" />
                    <refresh:FilledNumericSlider UnitKind="Angle" Unit="°" Grid.Column="1" Minimum="1" Maximum="89" Step="5" Format="0"
                                   Value="{Binding SupportBracingAngleDegrees, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing spacing vertical pitch mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Brace spacing" Classes="label" ToolTip.Tip="Vertical pitch between the braces of one pair of trunks. 0 = continuous: each brace starts where the last one ended" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="500" Step="1" Format="0.##"
                                   Value="{Binding SupportBracingSpacingMm, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing lowest brace height mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Lowest brace height" Classes="label" ToolTip.Tip="No brace foot below this height above the plate. 0 = the min branch height" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="500" Step="1" Format="0.##"
                                   Value="{Binding SupportBracingLowestHeightMm, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing min support height mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Min support height" Classes="label" ToolTip.Tip="Only trunks rising at least this far above the plate are braced" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="500" Step="1" Format="0.##"
                                   Value="{Binding SupportBracingMinSupportHeightMm, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing neighbour distance mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Neighbour distance" Classes="label" ToolTip.Tip="Largest horizontal gap between two trunks that a brace may span" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.5" Maximum="500" Step="0.5" Format="0.##"
                                   Value="{Binding SupportBracingNeighbourDistanceMm, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing max brace partners per trunk" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max brace partners" Classes="label" ToolTip.Tip="How many other trunks one trunk may be braced to" />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="" IsInteger="True" Grid.Column="1" Minimum="1" Maximum="20" Step="1" Format="0"
                                   Value="{Binding SupportBracingMaxPartners, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing max stem lean degrees branch continues trunk" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max stem lean °" Classes="label"
                               ToolTip.Tip="A branch continuing a trunk upward within this lean from vertical is braced as part of the trunk" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="89" Step="5" Format="0"
                                   Value="{Binding SupportBracingMaxStemLeanDegrees, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports bracing cluster gap bundle mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Cluster gap" Classes="label"
                               ToolTip.Tip="Trunks whose surfaces are closer than this are braced as one bundle: no braces inside the cluster, the row ties to its outer trunk. 0 = never" />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0" Maximum="100" Step="0.5" Format="0.##"
                                   Value="{Binding SupportBracingClusterGapMm, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="Placement" IsExpanded="True">
            <StackPanel Margin="8,2,0,6">
                <Grid Tag="supports placement spacing density mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Spacing" Classes="label" ToolTip.Tip="Distance between neighbouring tips on an overhang, mm. Closer holds better and marks more." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="1000" Step="0.1" Format="0.##"
                                   Value="{Binding SupportSpacing, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports placement island spacing dedup radius mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Island spacing" Classes="label" ToolTip.Tip="Tip spacing inside an island, mm; islands start the print off the plate, so they get denser tips than an ordinary overhang." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="1000" Step="0.1" Format="0.##"
                                   Value="{Binding SupportIslandSpacingMm, Mode=TwoWay}" />
                </Grid>
                <!-- Painted regions only: the even grid replaces overhang sampling there, and
                     vertical rows are the axis that has to stay even. -->
                <Grid Tag="supports placement painted region grid vertical row pitch mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Painted row pitch (Z)" Classes="label" ToolTip.Tip="Row pitch in Z for a painted region, mm: rows are what matters most on a wall." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="1000" Step="0.1" Format="0.##"
                                   Value="{Binding SupportRegionGridVerticalPitchMm, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports placement painted region grid horizontal along surface pitch mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Painted row spacing" Classes="label" ToolTip.Tip="Spacing along each painted row, measured along the surface, mm." />
                    <refresh:FilledNumericSlider UnitKind="Length" Unit="mm" Grid.Column="1" Minimum="0.01" Maximum="1000" Step="0.1" Format="0.##"
                                   Value="{Binding SupportRegionGridHorizontalPitchMm, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports placement overhang angle degrees threshold" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Overhang angle °" Classes="label" ToolTip.Tip="Faces that lean down more than this from vertical get supports, degrees. 0 is a wall, 90 a flat underside." />
                    <refresh:FilledNumericSlider UnitKind="Angle" Unit="°" Grid.Column="1" Minimum="0" Maximum="90" Step="1" Format="0"
                                   Value="{Binding SupportOverhangAngleDegrees, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports placement minimum island area square mm" ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Min island area mm²" Classes="label" ToolTip.Tip="An island smaller than this is ignored, mm². Below the minimum a region does not carry the layer above it." />
                    <refresh:FilledNumericSlider UnitKind="Scalar" Unit="mm²" Grid.Column="1" Minimum="0" Maximum="1000000" Step="0.1" Format="0.##"
                                   Value="{Binding SupportMinIslandAreaMm2, Mode=TwoWay}" />
                </Grid>
                <Grid Tag="supports placement contact face maximum angle from straight down degrees eligible"
                      ColumnDefinitions="170,*" Margin="0,2">
                    <TextBlock Text="Max angle from down °" Classes="label" ToolTip.Tip="A contact is only placed on a face within this angle of straight down, degrees. 90 = every downward face." />
                    <refresh:FilledNumericSlider UnitKind="Angle" Unit="°" Grid.Column="1" Minimum="0" Maximum="90" Step="1" Format="0"
                                   Value="{Binding SupportMaxContactFaceAngleDegrees, Mode=TwoWay}" />
                </Grid>
                <CheckBox Tag="supports placement require contact sees plate line of sight unobstructed"
                          Content="Require line of sight to plate"
                          IsChecked="{Binding SupportRequireContactSeesPlate, Mode=TwoWay}" Margin="0,4" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
